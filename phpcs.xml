<?xml version="1.0"?>
<ruleset name="Madya">
    <description>Madya PHP coding standard for CI4 view templates.</description>

    <file>src/theme</file>

    <arg name="colors" />
    <arg name="parallel" value="4" />
    <arg name="basepath" value="." />
    <arg name="extensions" value="php" />

    <!--
        Theme views intentionally mix PHP control syntax with HTML. Full PSR-12
        whitespace/indent sniffs are not suitable for mixed templates and produce
        false positives around alternative PHP syntax. Keep rules that remain
        meaningful without dictating HTML indentation.
    -->
    <rule ref="Generic.Files.EndFileNewline" />
    <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace" />
</ruleset>
